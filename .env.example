# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bakery_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/bakery_db?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""

# SMS Provider Configuration
# Options: console (dev), twilio, vietnam
SMS_PROVIDER="console"

# Twilio (if using)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Vietnam SMS Provider (FPT/Viettel/CMC)
VN_SMS_API_KEY=""
VN_SMS_API_URL=""
VN_SMS_BRAND_NAME="BakeryShop"

# App Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OPENAI_API_KEY=""
REDIS_URL="redis://localhost:6379"
CHATBOT_CACHE_TTL_SECONDS=600
# Transactional push (Story 9.2)
PUSH_TX_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
