              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Danh mục updated\",\n  \"description\": \"Mô tả mới\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Cập nhật danh mục (Admin only)"
          },
          "response": []
        },
        {
          "name": "[Admin] Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Xóa danh mục (Admin only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "[Admin] Get All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "PENDING",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Lấy danh sách đơn hàng (Admin only)"
          },
          "response": []
        },
        {
          "name": "[Admin] Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Cập nhật trạng thái đơn hàng (Admin only). Status: PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED"
          },
          "response": []
        }
      ]
    }
  ]
}
