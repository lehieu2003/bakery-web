{
  "info": {
    "name": "Bakery Shop API - Email Auth",
    "description": "API collection for Bakery Shop with email-based authentication system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@bakeryshop.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "admin123",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "test123",
      "type": "string"
    },
    {
      "key": "testOtp",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Flow",
          "item": [
            {
              "name": "1. Send OTP for Registration",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "register"]
                },
                "description": "Gửi OTP đến email để đăng ký tài khoản mới. OTP sẽ hết hạn sau 5 phút."
              },
              "response": []
            },
            {
              "name": "2. Verify OTP and Complete Registration",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{testOtp}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Test User\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register/verify",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "register", "verify"]
                },
                "description": "Xác thực OTP và hoàn tất đăng ký. Session cookie sẽ được tạo tự động."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Login",
          "item": [
            {
              "name": "Login with Email and Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                },
                "description": "Đăng nhập bằng email và mật khẩu. Không cần OTP. Session cookie sẽ được tạo tự động."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Reset Password Flow",
          "item": [
            {
              "name": "1. Send OTP for Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/reset-password",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "reset-password"]
                },
                "description": "Gửi OTP đến email để đặt lại mật khẩu. OTP sẽ hết hạn sau 5 phút."
              },
              "response": []
            },
            {
              "name": "2. Verify OTP and Reset Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{testOtp}}\",\n  \"newPassword\": \"newtest123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/reset-password/verify",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "reset-password", "verify"]
                },
                "description": "Xác thực OTP và đặt mật khẩu mới. Tất cả session cũ sẽ bị xóa."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Lấy thông tin người dùng hiện tại từ session cookie"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Đăng xuất và xóa session"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "category",
                  "value": "banh-mi",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "featured",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": "Lấy danh sách sản phẩm với phân trang và filter"
          },
          "response": []
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Lấy chi tiết một sản phẩm"
          },
          "response": []
        },
        {
          "name": "[Admin] Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bánh Mới\",\n  \"slug\": \"banh-moi\",\n  \"description\": \"Mô tả sản phẩm\",\n  \"price\": 30000,\n  \"comparePrice\": 35000,\n  \"stock\": 20,\n  \"categoryId\": \"\",\n  \"isActive\": true,\n  \"isFeatured\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products"]
            },
            "description": "Tạo sản phẩm mới (Admin only)"
          },
          "response": []
        },
        {
          "name": "[Admin] Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bánh Mới Updated\",\n  \"price\": 32000,\n  \"stock\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Cập nhật sản phẩm (Admin only)"
          },
          "response": []
        },
        {
          "name": "[Admin] Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Xóa sản phẩm (Admin only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "description": "Lấy tất cả danh mục"
          },
          "response": []
        },
        {
          "name": "[Admin] Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Danh mục mới\",\n  \"slug\": \"danh-muc-moi\",\n  \"description\": \"Mô tả danh mục\",\n  \"displayOrder\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/categories",
