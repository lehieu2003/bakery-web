+const createOrderDeps: CreateOrderRouteDeps = {
+  getCurrentUser: (request) =>
+    request ? getCurrentUserFromRequest(request) : Promise.resolve(null),
+  findProducts: (productIds) =>
+    prisma.product.findMany({
