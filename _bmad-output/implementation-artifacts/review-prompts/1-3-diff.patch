diff --git a/lib/auth/reset-password-utils.ts b/lib/auth/reset-password-utils.ts
new file mode 100644
index 0000000..e69401d
--- /dev/null
+++ b/lib/auth/reset-password-utils.ts
@@ -0,0 +1,56 @@
+export const RESET_PASSWORD_EXPIRES_IN_SECONDS = 300;
+
+const RESET_PASSWORD_GENERIC_MESSAGE = 'Nếu email tồn tại, OTP đã được gửi';
+const RESET_PASSWORD_VERIFY_SUCCESS_MESSAGE =
+  'Đặt lại mật khẩu thành công. Vui lòng đăng nhập lại';
+const RESET_PASSWORD_VERIFY_INVALID_REQUEST_MESSAGE =
+  'Yêu cầu đặt lại mật khẩu không hợp lệ';
+
+type ResetPasswordPrismaClient = {
+  user: {
+    update: (args: {
+      where: { id: string };
+      data: { password: string };
+    }) => Promise<unknown>;
+  };
+  session: {
+    deleteMany: (args: { where: { userId: string } }) => Promise<unknown>;
+  };
+};
+
+export function buildResetPasswordRequestSuccessData(email: string) {
+  return {
+    message: RESET_PASSWORD_GENERIC_MESSAGE,
+    email: email.trim().toLowerCase(),
+    expiresIn: RESET_PASSWORD_EXPIRES_IN_SECONDS,
+  };
+}
+
+export function buildResetPasswordVerifySuccessData() {
+  return {
+    message: RESET_PASSWORD_VERIFY_SUCCESS_MESSAGE,
+  };
+}
+
+export function sanitizeResetPasswordVerifyError(error: string) {
+  if (error === 'Người dùng không tồn tại') {
+    return RESET_PASSWORD_VERIFY_INVALID_REQUEST_MESSAGE;
+  }
+
+  return error;
+}
+
+export async function applyPasswordReset(
+  prismaClient: ResetPasswordPrismaClient,
+  userId: string,
+  passwordHash: string,
+) {
+  await prismaClient.user.update({
+    where: { id: userId },
+    data: { password: passwordHash },
+  });
+
+  await prismaClient.session.deleteMany({
+    where: { userId },
+  });
+}
diff --git a/tests/auth/reset-password-utils.test.ts b/tests/auth/reset-password-utils.test.ts
new file mode 100644
index 0000000..1c1238b
--- /dev/null
+++ b/tests/auth/reset-password-utils.test.ts
@@ -0,0 +1,69 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  RESET_PASSWORD_EXPIRES_IN_SECONDS,
+  applyPasswordReset,
+  buildResetPasswordRequestSuccessData,
+  buildResetPasswordVerifySuccessData,
+  sanitizeResetPasswordVerifyError,
+} from '@/lib/auth/reset-password-utils';
+
+test('buildResetPasswordRequestSuccessData returns stable generic payload', () => {
+  const payload = buildResetPasswordRequestSuccessData('User@Example.com');
+
+  assert.equal(payload.message, 'Nếu email tồn tại, OTP đã được gửi');
+  assert.equal(payload.email, 'user@example.com');
+  assert.equal(payload.expiresIn, RESET_PASSWORD_EXPIRES_IN_SECONDS);
+});
+
+test('buildResetPasswordVerifySuccessData returns reset success message', () => {
+  const payload = buildResetPasswordVerifySuccessData();
+  assert.equal(payload.message, 'Đặt lại mật khẩu thành công. Vui lòng đăng nhập lại');
+});
+
+test('sanitizeResetPasswordVerifyError hides account existence details', () => {
+  assert.equal(
+    sanitizeResetPasswordVerifyError('Người dùng không tồn tại'),
+    'Yêu cầu đặt lại mật khẩu không hợp lệ',
+  );
+  assert.equal(
+    sanitizeResetPasswordVerifyError('OTP không đúng'),
+    'OTP không đúng',
+  );
+});
+
+test('applyPasswordReset updates password and revokes all active sessions', async () => {
+  const calls: Array<{ method: string; payload: unknown }> = [];
+
+  const prismaClient = {
+    user: {
+      async update(args: unknown) {
+        calls.push({ method: 'user.update', payload: args });
+        return null;
+      },
+    },
+    session: {
+      async deleteMany(args: unknown) {
+        calls.push({ method: 'session.deleteMany', payload: args });
+        return null;
+      },
+    },
+  };
+
+  await applyPasswordReset(prismaClient, 'user-1', 'hashed-password');
+
+  assert.deepEqual(calls[0], {
+    method: 'user.update',
+    payload: {
+      where: { id: 'user-1' },
+      data: { password: 'hashed-password' },
+    },
+  });
+
+  assert.deepEqual(calls[1], {
+    method: 'session.deleteMany',
+    payload: {
+      where: { userId: 'user-1' },
+    },
+  });
+});
