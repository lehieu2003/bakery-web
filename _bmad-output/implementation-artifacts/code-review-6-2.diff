+      requireAdmin: async () => ({ id: 'admin-1', role: 'ADMIN' }),
+      findAttributes: async () => [],
+      findAttributeBySlug: async () => null,
+      findAttributeByCode: async () => null,
+      createAttribute: async () => ({}),
