generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

////////////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////////////

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum MemberLevel {
  SILVER
  GOLD
  PLATINUM
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponSourceType {
  PUBLIC
  TARGETED
  TRIGGERED
}

enum CouponRedemptionState {
  RESERVED
  COMMITTED
  RELEASED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
  ZALOPAY
}

enum MenuType {
  CATEGORY
  PAGE
  LINK
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationAudience {
  GLOBAL
  USER
}

enum NotificationDispatchStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProductAttributeType {
  SELECT
  MULTI_SELECT
  TEXT
  NUMBER
  BOOLEAN
}

////////////////////////////////////////////////////////////
// USER & AUTH
////////////////////////////////////////////////////////////

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
  phone    String?

  role UserRole @default(CUSTOMER)

  memberLevel MemberLevel @default(SILVER)
  points      Int         @default(0)

  emailVerifiedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions             Session[]
  orders               Order[]
  addresses            Address[]
  reviews              Review[]
  wishlist             Wishlist[]
  blogPosts            BlogPost[]
  blogComments         BlogComment[]
  notificationsCreated Notification[]
  notificationsTargeted Notification[] @relation("NotificationTarget")
  notificationReads    NotificationRead[]
  notificationDispatches NotificationDispatch[]
  couponAssignments    CouponAssignment[] @relation("CouponAssignee")
  issuedCouponAssignments CouponAssignment[] @relation("CouponIssuer")
  couponRedemptions    CouponRedemption[]
  couponAuditLogs      CouponAuditLog[]   @relation("CouponAuditActor")

  cart Cart?

  @@index([email])
}

model Session {
  id String @id @default(cuid())

  userId String
  token  String @unique

  expiresAt DateTime

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id String @id @default(cuid())

  email   String
  purpose OtpPurpose

  otpHash String

  expiresAt DateTime

  attempts Int @default(0)

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
}

////////////////////////////////////////////////////////////
// ADDRESS
////////////////////////////////////////////////////////////

model Address {
  id String @id @default(cuid())

  userId String

  fullName String
  phone    String

  province String
  district String
  ward     String
  street   String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

////////////////////////////////////////////////////////////
// CATEGORY TREE
////////////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  imageUrl String?

  parentId String?

  level        Int @default(1)
  displayOrder Int @default(0)

  isActive   Boolean @default(true)
  showInMenu Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products  ProductCategory[]
  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

////////////////////////////////////////////////////////////
// PRODUCT
////////////////////////////////////////////////////////////

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  description      String?
  shortDescription String?

  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal?
  costPrice    Decimal?

  sku     String?
  barcode String?

  stock      Int     @default(0)
  trackStock Boolean @default(true)

  weight Float?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  images               ProductImage[]
  variants             ProductVariant[]
  categories           ProductCategory[]
  reviews              Review[]
  wishlist             Wishlist[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  attributeAssignments ProductAttributeAssignment[]

  @@index([isActive, price])
  @@index([stock, trackStock])
}

model ProductAttribute {
  id String @id @default(cuid())

  name String
  slug String @unique

  code String               @unique
  type ProductAttributeType @default(SELECT)

  description String?

  isRequired    Boolean @default(false)
  isFilterable  Boolean @default(true)
  isVariantAxis Boolean @default(false)
  isActive      Boolean @default(true)
  displayOrder  Int     @default(0)

  values      ProductAttributeValue[]
  assignments ProductAttributeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, isFilterable, displayOrder])
  @@index([type])
}

model ProductAttributeValue {
  id String @id @default(cuid())

  attributeId String

  value        String
  slug         String
  label        String
  colorHex     String?
  imageUrl     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  attribute   ProductAttribute             @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  assignments ProductAttributeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([attributeId, slug])
  @@unique([attributeId, value])
  @@index([attributeId, isActive, displayOrder])
}

model ProductAttributeAssignment {
  id          String  @id @default(cuid())
  productId   String
  attributeId String
  valueId     String?
  valueKey    String

  textValue    String?
  numberValue  Decimal? @db.Decimal(10, 2)
  booleanValue Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     ProductAttributeValue? @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, valueKey])
  @@index([productId])
  @@index([attributeId])
  @@index([valueId])
  @@index([attributeId, valueId])
  @@index([attributeId, textValue])
  @@index([attributeId, numberValue])
  @@index([attributeId, booleanValue])
}

////////////////////////////////////////////////////////////
// PRODUCT CATEGORY (many-to-many)
////////////////////////////////////////////////////////////

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

////////////////////////////////////////////////////////////
// PRODUCT IMAGES
////////////////////////////////////////////////////////////

model ProductImage {
  id String @id @default(cuid())

  productId String

  url String

  altText String?

  displayOrder Int @default(0)

  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

////////////////////////////////////////////////////////////
// PRODUCT VARIANTS
////////////////////////////////////////////////////////////

model ProductVariant {
  id String @id @default(cuid())

  productId String

  name String

  sku String?

  price Decimal @db.Decimal(10, 2)

  stock Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]
}

////////////////////////////////////////////////////////////
// CART
////////////////////////////////////////////////////////////

model Cart {
  id String @id @default(cuid())

  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id])

  items CartItem[]
}

model CartItem {
  id String @id @default(cuid())

  cartId String

  productId String
  variantId String?

  quantity Int @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

////////////////////////////////////////////////////////////
// ORDER
////////////////////////////////////////////////////////////

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  userId String?

  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String?

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  paymentMethod PaymentMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  payment    Payment?
  couponRedemptions CouponRedemption[]
}

model OrderItem {
  id String @id @default(cuid())

  orderId String

  productId String
  variantId String?

  name String

  price Decimal @db.Decimal(10, 2)

  quantity Int

  subtotal Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

////////////////////////////////////////////////////////////
// PAYMENT
////////////////////////////////////////////////////////////

model Payment {
  id String @id @default(cuid())

  orderId String @unique

  provider String

  transactionId String?

  amount Decimal @db.Decimal(10, 2)

  status String

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

////////////////////////////////////////////////////////////
// REVIEW
////////////////////////////////////////////////////////////

model Review {
  id String @id @default(cuid())

  userId    String
  productId String

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

////////////////////////////////////////////////////////////
// WISHLIST
////////////////////////////////////////////////////////////

model Wishlist {
  id String @id @default(cuid())

  userId    String
  productId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

////////////////////////////////////////////////////////////
// COUPON
////////////////////////////////////////////////////////////

model Coupon {
  id String @id @default(cuid())

  code String @unique

  sourceType CouponSourceType @default(PUBLIC)

  type  DiscountType
  value Decimal      @db.Decimal(10, 2)

  minOrder    Decimal?
  maxDiscount Decimal?

  usageLimit Int?
  perUserLimit Int?

  scopeProductIds  String[] @default([])
  scopeCategoryIds String[] @default([])

  startAt DateTime
  endAt   DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assignments CouponAssignment[]
  redemptions CouponRedemption[]
  auditLogs   CouponAuditLog[]
}

model CouponAssignment {
  id String @id @default(cuid())

  couponId String
  userId   String?
  issuedById String?

  targetSegment MemberLevel?
  isActive      Boolean      @default(true)

  issuedAt  DateTime @default(now())
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User?  @relation("CouponAssignee", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User?  @relation("CouponIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([couponId, isActive])
  @@index([userId, isActive])
  @@index([targetSegment, isActive])
}

model CouponRedemption {
  id String @id @default(cuid())

  couponId String
  orderId  String
  userId   String?

  state CouponRedemptionState @default(RESERVED)

  reservedDiscount Decimal  @db.Decimal(10, 2)
  reservedAt       DateTime @default(now())
  committedAt      DateTime?
  releasedAt       DateTime?
  releaseReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([couponId, state])
  @@index([orderId, state])
  @@index([userId, state])
}

model CouponAuditLog {
  id String @id @default(cuid())

  couponId     String
  actorUserId  String?
  actorRole    UserRole?
  mutationType String
  beforeData   Json?
  afterData    Json?

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  actor  User?  @relation("CouponAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([couponId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

////////////////////////////////////////////////////////////
// MENU (for navigation)
////////////////////////////////////////////////////////////

model MenuItem {
  id String @id @default(cuid())

  title String

  url String?

  parentId   String?
  categoryId String?
  pageId     String?

  type MenuType @default(CATEGORY)

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuTree")

  category Category? @relation(fields: [categoryId], references: [id])
  page     Page?     @relation(fields: [pageId], references: [id])
}

////////////////////////////////////////////////////////////
// CMS PAGE
////////////////////////////////////////////////////////////

model Page {
  id String @id @default(cuid())

  title String
  slug  String @unique

  content String

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  menuItems MenuItem[]
}

////////////////////////////////////////////////////////////
// BANNER
////////////////////////////////////////////////////////////

model Banner {
  id String @id @default(cuid())

  title       String
  description String?

  imageUrl String?
  linkUrl  String?

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

////////////////////////////////////////////////////////////
// NOTIFICATION
////////////////////////////////////////////////////////////

model Notification {
  id String @id @default(cuid())

  title   String
  content String
  imageUrl String?
  linkUrl String?

  audience     NotificationAudience @default(GLOBAL)
  targetUserId String?

  status      NotificationStatus @default(DRAFT)
  publishedAt DateTime?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  createdBy  User                   @relation(fields: [createdById], references: [id])
  targetUser User?                  @relation("NotificationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  reads      NotificationRead[]
  dispatches NotificationDispatch[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([audience, targetUserId, status, publishedAt(sort: Desc)])
}

model NotificationRead {
  notificationId String
  userId         String

  readAt DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt(sort: Desc)])
}

model NotificationDispatch {
  id String @id @default(cuid())

  correlationKey String @unique
  eventType      String
  entityId       String

  targetUserId String?
  targetEmail  String?

  status       NotificationDispatchStatus @default(PENDING)
  channel      String?
  attemptCount Int                        @default(0)
  error        String?

  notificationId String?
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  targetUser     User?         @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  processedAt DateTime?

  @@index([eventType, createdAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
}

////////////////////////////////////////////////////////////
// BLOG
////////////////////////////////////////////////////////////

model BlogCategory {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?
  imageUrl    String?

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  posts BlogPost[]
}

model BlogTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts BlogPostTag[]
}

model BlogPost {
  id String @id @default(cuid())

  title   String
  slug    String  @unique
  excerpt String?

  content  String
  coverUrl String?

  authorId   String
  categoryId String?

  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?

  viewCount Int @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  tags     BlogPostTag[]
  comments BlogComment[]

  @@index([slug])
  @@index([status, publishedAt])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogComment {
  id String @id @default(cuid())

  postId String
  userId String?

  // Guest comment (không cần đăng nhập)
  guestName  String?
  guestEmail String?

  content String

  isApproved Boolean @default(false)

  parentId String?
  parent   BlogComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  BlogComment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id])

  @@index([postId])
}

////////////////////////////////////////////////////////////
// SETTINGS
////////////////////////////////////////////////////////////

model Setting {
  id String @id @default(cuid())

  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

